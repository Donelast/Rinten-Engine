@namespace Editor.Inspectors
@using Rinten.UI
@using System

@attribute [CustomEditor( typeof( string ), WithAllAttributes = [ typeof( ShaderNameAttribute ) ] )]
@attribute [StyleSheet( "ShaderNameControl.razor.scss" )]

@inherits BaseControl

<root onclick="@Open">
	<span class="name @(Multiple ? "multiple" : null)">@Name</span>
	<i class="dropdown_indicator">expand_more</i>
</root>

@code
{
	public override bool SupportsMultiEdit => true;

	ShaderPickerPopup _picker;

	bool Multiple => Property?.IsMultipleDifferentValues ?? false;

	//What the closed field says, worked out from the path alone. From the path, and it matters: this is what the row shows, so it is asked whenever
	//the sheet rebuilds. The list reads every shader on the disk to build itself, which is fine once when somebody opens it and not fine on a rebuild.
	string Name => Multiple ? "Multiple Values" : MaterialDefinition.ShaderTitle( Property?.As.String );

	void Open()
	{
		if ( IsReadOnly || Property is null ) return;

		//A second click on an open field closes it, rather than opening a second list on top of the first.
		if ( _picker.IsValid() )
		{
			_picker.Delete();
			_picker = null;

			return;
		}

		_picker = ShaderPickerPopup.Open( this, Property.As.String, Choose );
	}

	void Choose( string path )
	{
		if ( IsReadOnly || Property is null ) return;
		if ( string.Equals( Property.As.String, path, StringComparison.OrdinalIgnoreCase ) ) return;

		Property.Parent?.NoteStartEdit( Property );
		Property.As.String = path;
		Property.Parent?.NoteFinishEdit( Property );

		StateHasChanged();
	}

	public override void Tick()
	{
		base.Tick();

		if ( !_picker.IsValid() ) _picker = null;
	}

	protected override int BuildHash() => HashCode.Combine( Name, Multiple, IsReadOnly );
}
